@AboveMarks = [gravecomb acutecomb uni0302 tildecomb uni0304 uni0306 uni0307 uni0308 hookabovecomb uni030A uni030B uni030C uni030F uni0311];
lookup Dotless {
lookupflag UseMarkFilteringSet @AboveMarks;
sub iogonek' @AboveMarks by iogonek.dotless;
sub i' @AboveMarks by i.dotless;
sub j' @AboveMarks by uni0237;
} Dotless;
feature ccmp { lookup Compose; lookup Dotless; } ccmp;
